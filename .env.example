# Server Port (default 8080 for Cloud Run)
PORT=8080

# Google Cloud Project Configuration
GCP_PROJECT_ID=sih26-508313
GCP_LOCATION=asia-south1
VERTEX_MODEL=gemini-2.5-flash
VERTEX_VOICE_MODEL=gemini-live-2.5-flash-native-audio

# Google OAuth 2.0 Credentials (from client_secret_*.json in GCP Console)
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret

# JWT Secret (min 256-bit / 32 characters for HMAC-SHA256)
JWT_SECRET=vyapaarsathi-sih26091-super-secure-jwt-signing-secret-key-32-chars-minimum

# Google Maps API Key (Must have Places API New, Geocoding API, and Area Insights enabled)
GOOGLE_MAPS_API_KEY=AIzaSy...your_google_maps_api_key_here

# Cloud SQL MySQL Database Credentials
# Instance Connection Name: <project>:<region>:<instance>
CLOUD_SQL_CONNECTION_NAME=sih26-508313:asia-south1:sih26-mysql
DB_NAME=sih26_app_db
DB_USER=root
DB_PASSWORD=your_cloud_sql_root_password
DB_HOST=34.93.230.76
DB_PORT=3306

# SQLite Layer 2 Database Path (Pre-indexed static dataset)
LAYER2_DB_PATH=Optimized DB for Layer 2/layer2_demand_economics.db
